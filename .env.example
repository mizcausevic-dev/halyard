# Copy to .env for local development. This key is a public sample.
# Generate a real 32-byte key before any shared or production deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HALYARD_ENV=development
DATABASE_URL=postgres://halyard:halyard@127.0.0.1:5432/halyard
CREDENTIAL_ENCRYPTION_KEY=aGFseWFyZC1kZXYta2V5LW5vdC1mb3ItcHJvZCEhISE=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
# Previous keys, kept only while re-encrypting: "1:<base64>,2:<base64>"
CREDENTIAL_DECRYPT_KEYS=
SESSION_SECRET=dev-session-secret-change-me
HALYARD_ORIGIN=http://127.0.0.1:5173
API_PORT=8787
WORKER_ID=
WORKER_POLL_MS=400
WORKER_CONCURRENCY=2
WORKER_LEASE_MS=30000
# Exact hosts that may receive outbound HTTP even when they resolve privately.
# Ignored when HALYARD_ENV=production.
HALYARD_SSRF_ALLOW_HOSTS=127.0.0.1
FIXTURE_PORT=4099
FIXTURE_BASE_URL=http://127.0.0.1:4099
HALYARD_SEED=true
DEMO_USER_EMAIL=ada@halyard.dev
DEMO_USER_PASSWORD=halyard-dev-password
DEMO_USER_NAME=Ada Quartermain
